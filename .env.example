# Copy to .env. Never commit credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EKT_USERNAME=
EKT_PASSWORD=
# demo: synthetic catalog; live: authenticated EKT read API
CATALOG_MODE=demo
CATALOG_PAGES=20
APP_HOST=127.0.0.1
APP_PORT=8000
# Local AI configuration is available only from loopback when enabled.
ALLOW_LOCAL_SETUP=0
